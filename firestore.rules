rules_version = '2';

// Publicar manualmente no Firebase Console (Firestore Database > Regras) ou via
// `firebase deploy --only firestore:rules` — este repositório não tem o Firebase
// CLI configurado para deploy automático.
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só lê/escreve o próprio documento de backup (user_backups/{uid}),
    // onde fica o espelho completo dos dados locais (ver CloudBackupRepository.kt).
    match /user_backups/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
