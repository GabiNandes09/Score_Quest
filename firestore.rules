rules_version = '2';

// Publicar manualmente no Firebase Console (Firestore Database > Regras) ou via
// `firebase deploy --only firestore:rules` — este repositório não tem o Firebase
// CLI configurado para deploy automático.
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só lê/escreve os próprios dados, normalizados por coleção
    // em users/{uid}/... (games, players, sessions, etc. — ver CloudBackupRepository.kt).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
