rules_version = '2';

// Publicar manualmente no Firebase Console (Firestore Database > Regras) ou via
// `firebase deploy --only firestore:rules` — este repositório não tem o Firebase
// CLI configurado para deploy automático.
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo compartilhado (jogos + pontuação personalizada): qualquer
    // usuário logado lê e escreve, sem dono — mesmo modelo de permissão
    // "fase atual" já usado antes de ter conta (ver CLAUDE.md).
    match /games/{gameId} {
      allow read, write: if request.auth != null;
    }
    match /scoreSchemas/{gameId} {
      allow read, write: if request.auth != null;
    }

    // Diretório público mínimo (nome/e-mail/foto da conta Google + @username,
    // ver EnsurePublicProfileUseCase): qualquer usuário logado lê (precisa
    // existir pra um dia dar pra buscar/reconhecer outra conta), só o próprio
    // dono escreve o seu. O contador de @username é um recurso compartilhado
    // sem dono — qualquer logado precisa poder incrementar.
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /usernameCounters/{slug} {
      allow read, write: if request.auth != null;
    }

    // Dado pessoal: cada usuário só lê/escreve os próprios dados, normalizados
    // por coleção em users/{uid}/... (libraryEntries, players, sessions, etc.
    // — ver CloudBackupRepository.kt).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
